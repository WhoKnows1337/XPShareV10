# ==============================================
# SUPABASE
# ==============================================
NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================
# VERCEL KV (Rate Limiting)
# ==============================================
# Optional: If not set, falls back to in-memory rate limiting
# Get these from Vercel Dashboard → Storage → KV → .env.local tab
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your-kv-token

# ==============================================
# AI PROVIDERS
# ==============================================
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4, Embeddings, Whisper)
OPENAI_API_KEY=sk-...

# ==============================================
# STORAGE (R2/S3)
# ==============================================
# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=xpshare-media
R2_PUBLIC_URL=https://media.your-domain.com

# AWS S3 (Alternative)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=xpshare-bucket

# ==============================================
# NEO4J (Graph Database)
# ==============================================
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password

# ==============================================
# APPLICATION
# ==============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ==============================================
# EMAIL (Resend)
# ==============================================
RESEND_API_KEY=re_...

# ==============================================
# FEATURE FLAGS
# ==============================================
# Enable Cross-Encoder Re-Ranking for search
NEXT_PUBLIC_ENABLE_RERANKING=false

# ==============================================
# MONITORING (Optional)
# ==============================================
# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id

# ==============================================
# MCP SERVERS (Optional)
# ==============================================
# Exa AI
EXA_API_KEY=your-exa-key

# Linear
LINEAR_API_KEY=your-linear-key

# Vibe Check
VIBE_CHECK_API_KEY=your-vibe-key
